{
  "name": "graphicmotion",
  "private": true,
  "description": "Home Deluxe motion-graphics pipeline: HTML compositions rendered frame by frame to MP4.",
  "scripts": {
    "laguna-m:plates": "scripts/prepare_plates.sh projects/laguna-m/source/laguna-m_rohschnitt.mp4 build/laguna-m/plates",
    "laguna-m:track": "python3 -I scripts/track_points.py build/laguna-m/plates projects/laguna-m/tracking.json projects/laguna-m/tracks.js",
    "laguna-m:render": "node scripts/render.js projects/laguna-m/composition.html projects/laguna-m/output/HomeDeluxe_Laguna-M_Reel_9x16.mp4 --plates build/laguna-m/plates",
    "laguna-m:stills": "node scripts/render.js projects/laguna-m/composition.html build/laguna-m/stills --plates build/laguna-m/plates --stills 1,2,4,5,7,10,11,13,14.5,16,17.6,18,19,21",
    "halloween:graphics": "node projects/newsletter-halloween/scripts/render_graphics.js build/newsletter-halloween/graphics",
    "halloween:images": "python3 -I projects/newsletter-halloween/scripts/build_images.py projects/newsletter-halloween build/newsletter-halloween/graphics",
    "halloween:html": "python3 -I projects/newsletter-halloween/scripts/build_newsletter.py projects/newsletter-halloween",
    "halloween:preview": "node projects/newsletter-halloween/scripts/preview.js projects/newsletter-halloween/output/newsletter-halloween-kw44.html projects/newsletter-halloween/output/popup/clown-popup.html projects/newsletter-halloween/output/preview",
    "halloween:build": "npm run halloween:graphics && npm run halloween:images && npm run halloween:html && npm run halloween:preview && npm run halloween:vorschau",
    "halloween:vorschau": "python3 -I projects/newsletter-halloween/scripts/build_vorschau.py projects/newsletter-halloween",
    "halloween:videos": "python3 -I projects/newsletter-halloween/scripts/build_hero_videos.py projects/newsletter-halloween"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}

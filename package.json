{
  "name": "graphicmotion",
  "private": true,
  "description": "Home Deluxe motion-graphics pipeline: HTML compositions rendered frame by frame to MP4.",
  "scripts": {
    "laguna-m:plates": "scripts/prepare_plates.sh projects/laguna-m/source/laguna-m_rohschnitt.mp4 build/laguna-m/plates",
    "laguna-m:track": "python3 -I scripts/track_points.py build/laguna-m/plates projects/laguna-m/tracking.json projects/laguna-m/tracks.js",
    "laguna-m:render": "node scripts/render.js projects/laguna-m/composition.html projects/laguna-m/output/HomeDeluxe_Laguna-M_Reel_9x16.mp4 --plates build/laguna-m/plates",
    "laguna-m:stills": "node scripts/render.js projects/laguna-m/composition.html build/laguna-m/stills --plates build/laguna-m/plates --stills 1.2,2.2,2.9,3.6,4.9,5.6,8.0,9.9,11.6,13.1,15.6,17.0,18.6,20.6,22.4,24.8",
    "black-week:plates": "scripts/prepare_plates.sh projects/black-week/source/black-week_rohschnitt.mp4 build/black-week/plates && scripts/slowmo_plates.sh build/black-week/plates build/black-week/slow 4 0-47 144-191 48-95 192-231 96-143 240-288",
    "black-week:render": "node scripts/render.js projects/black-week/composition.html projects/black-week/output/HomeDeluxe_BlackWeek_Staffelrabatt_9x16.mp4 --plates build/black-week/slow",
    "black-week:stills": "node scripts/render.js projects/black-week/composition.html build/black-week/stills --plates build/black-week/slow --stills 1.2,2.2,2.9,3.6,4.9,5.6,8.0,9.9,11.6,13.1,15.6,17.0,18.6,20.6,22.4,24.8",
    "black-friday:plates": "scripts/prepare_plates.sh projects/black-friday/source/black-friday_rohschnitt.mp4 build/black-friday/plates && scripts/slowmo_plates.sh build/black-friday/plates build/black-friday/slow 4 0-36 36-72 72-108 108-144",
    "black-friday:audio": "python3 -I scripts/build_audio.py projects/black-friday/source/black-friday_rohschnitt.mp4 \"$PWD/projects/black-friday/timeline.js\" build/black-friday/audio.wav",
    "black-friday:render": "npm run -s black-friday:audio && node scripts/render.js projects/black-friday/composition.html projects/black-friday/output/HomeDeluxe_BlackFriday_25_9x16.mp4 --plates build/black-friday/slow --audio build/black-friday/audio.wav",
    "black-friday:stills": "node scripts/render.js projects/black-friday/composition.html build/black-friday/stills --plates build/black-friday/slow --stills 0.42,0.8,1.25,3.0,5.1,5.6,7.6,8.4,9.0,12.5"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}

{
  "name": "graphicmotion",
  "private": true,
  "description": "Home Deluxe motion-graphics pipeline: HTML compositions rendered frame by frame to MP4.",
  "scripts": {
    "laguna-m:plates": "scripts/prepare_plates.sh projects/laguna-m/source/laguna-m_rohschnitt.mp4 build/laguna-m/plates",
    "laguna-m:track": "python3 -I scripts/track_points.py build/laguna-m/plates projects/laguna-m/tracking.json projects/laguna-m/tracks.js",
    "laguna-m:render": "node scripts/render.js projects/laguna-m/composition.html projects/laguna-m/output/HomeDeluxe_Laguna-M_Reel_9x16.mp4 --plates build/laguna-m/plates",
    "laguna-m:stills": "node scripts/render.js projects/laguna-m/composition.html build/laguna-m/stills --plates build/laguna-m/plates --stills 1,2,4,5,7,10,11,13,14.5,16,17.6,18,19,21",
    "thermo-scan:plates": "python3 -I projects/thermo-scan/prepare.py projects/thermo-scan/source build/thermo-scan/plates",
    "thermo-scan:sound": "python3 -I projects/thermo-scan/sound.py build/thermo-scan/sound.wav",
    "thermo-scan:render": "projects/thermo-scan/render.sh",
    "thermo-scan:stills": "node scripts/render.js projects/thermo-scan/composition.html build/thermo-scan/stills --plates build/thermo-scan/plates --serve 1 --size 1080x1080 --stills 1,3.5,4.7,6.4,7.5,9,10.8,12,13.6,16.6,18,19.6,21,23.5,25.5",
    "thermo-scan:render:9x16": "projects/thermo-scan/render.sh 9x16",
    "thermo-scan:stills:9x16": "node scripts/render.js projects/thermo-scan/premium.html build/thermo-scan/stills_9x16 --plates build/thermo-scan/plates --serve 1 --size 1080x1920 --stills 1.2,3.0,4.6,5.6,7.0,9.0,10.8,12.8,16.0,17.6,20.5,22.0,25.0,27.0,30.0,34.0,37.5"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "three": "0.169.0"
  }
}

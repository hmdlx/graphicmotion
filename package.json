{
  "name": "graphicmotion",
  "private": true,
  "description": "Home Deluxe motion-graphics pipeline: HTML compositions rendered frame by frame to MP4.",
  "scripts": {
    "laguna-m:plates": "scripts/prepare_plates.sh projects/laguna-m/source/laguna-m_rohschnitt.mp4 build/laguna-m/plates",
    "laguna-m:track": "python3 -I scripts/track_points.py build/laguna-m/plates projects/laguna-m/tracking.json projects/laguna-m/tracks.js",
    "laguna-m:render": "node scripts/render.js projects/laguna-m/composition.html projects/laguna-m/output/HomeDeluxe_Laguna-M_Reel_9x16.mp4 --plates build/laguna-m/plates",
    "laguna-m:stills": "node scripts/render.js projects/laguna-m/composition.html build/laguna-m/stills --plates build/laguna-m/plates --stills 1,2,4,5,7,10,11,13,14.5,16,17.6,18,19,21",
    "black-week:plates": "scripts/prepare_plates.sh projects/black-week/source/black-week_rohschnitt.mp4 build/black-week/plates",
    "black-week:render": "node scripts/render.js projects/black-week/composition.html projects/black-week/output/HomeDeluxe_BlackWeek_Staffelrabatt_9x16.mp4 --plates build/black-week/plates",
    "black-week:stills": "node scripts/render.js projects/black-week/composition.html build/black-week/stills --plates build/black-week/plates --stills 0.6,1.3,2.0,3.0,4.2,5.2,6.0,7.0,8.6,9.6,12.4,12.9,13.5,14.5,15.5,17.5"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}

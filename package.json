{
  "name": "graphicmotion",
  "private": true,
  "description": "Home Deluxe motion-graphics pipeline: HTML compositions rendered frame by frame to MP4.",
  "scripts": {
    "laguna-m:plates": "scripts/prepare_plates.sh projects/laguna-m/source/laguna-m_rohschnitt.mp4 build/laguna-m/plates",
    "laguna-m:track": "python3 -I scripts/track_points.py build/laguna-m/plates projects/laguna-m/tracking.json projects/laguna-m/tracks.js",
    "laguna-m:render": "node scripts/render.js projects/laguna-m/composition.html projects/laguna-m/output/HomeDeluxe_Laguna-M_Reel_9x16.mp4 --plates build/laguna-m/plates",
    "laguna-m:stills": "node scripts/render.js projects/laguna-m/composition.html build/laguna-m/stills --plates build/laguna-m/plates --stills 1,2,4,5,7,10,11,13,14.5,16,17.6,18,19,21",
    "whirlpool:model": "mkdir -p build/models && curl -fL -o build/models/rife49.onnx https://huggingface.co/yuvraj108c/rife-onnx/resolve/main/rife49_ensemble_True_scale_1_sim.onnx",
    "whirlpool:plates": "python3 -I scripts/retime.py projects/whirlpool/edit.json projects/whirlpool/source/whirlpool_quelle.mp4 build/whirlpool/plates projects/whirlpool/timeline.js --model build/models/rife49.onnx",
    "whirlpool:music": "python3 -I scripts/music.py projects/whirlpool/edit.json projects/whirlpool/source/whirlpool_quelle.mp4 build/whirlpool/music.wav",
    "whirlpool:render": "node scripts/render.js projects/whirlpool/composition.html projects/whirlpool/output/HomeDeluxe_Whirlpool_Details_Reel_9x16.mp4 --plates build/whirlpool/plates --audio build/whirlpool/music.wav",
    "whirlpool:stills": "node scripts/render.js projects/whirlpool/composition.html build/whirlpool/stills --plates build/whirlpool/plates --stills 0.5,1.6,3.5,4.5,6,8,10.5,12.5,14.5,17"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}

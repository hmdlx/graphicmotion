{
  "name": "graphicmotion",
  "private": true,
  "description": "Home Deluxe motion-graphics pipeline: HTML compositions rendered frame by frame to MP4.",
  "scripts": {
    "laguna-m:plates": "scripts/prepare_plates.sh projects/laguna-m/source/laguna-m_rohschnitt.mp4 build/laguna-m/plates",
    "laguna-m:track": "python3 -I scripts/track_points.py build/laguna-m/plates projects/laguna-m/tracking.json projects/laguna-m/tracks.js",
    "laguna-m:render": "node scripts/render.js projects/laguna-m/composition.html projects/laguna-m/output/HomeDeluxe_Laguna-M_Reel_9x16.mp4 --plates build/laguna-m/plates",
    "laguna-m:stills": "node scripts/render.js projects/laguna-m/composition.html build/laguna-m/stills --plates build/laguna-m/plates --stills 1,2,4,5,7,10,11,13,14.5,16,17.6,18,19,21",
    "callado:frames": "scripts/extract_frames.sh projects/callado-zubehoer/source/HomeDeluxe_CALLADO-Zubehoer_16x9.mp4 build/callado-zubehoer/plates 720",
    "callado:logo": "python3 -I scripts/logo_matte.py build/callado-zubehoer/plates build/callado-zubehoer/logo.png --box 1560,186,1780,224 --ref 100-160 --clean 56-159",
    "callado:intro": "node scripts/render.js projects/callado-zubehoer/composition.html build/callado-zubehoer/intro.mp4 --plates build/callado-zubehoer/plates --crf 0",
    "callado:join": "scripts/join_intro.sh build/callado-zubehoer/intro.mp4 projects/callado-zubehoer/source/HomeDeluxe_CALLADO-Zubehoer_16x9.mp4 160 projects/callado-zubehoer/output/HomeDeluxe_CALLADO-Zubehoer_16x9_Intro.mp4",
    "callado:stills": "node scripts/render.js projects/callado-zubehoer/composition.html build/callado-zubehoer/stills --plates build/callado-zubehoer/plates --stills 0.8,1.6,3,4,4.5,4.9,5.3,5.6"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
